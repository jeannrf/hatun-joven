rules_version = '2';

// La web solo puede CREAR registros válidos. Solo la cuenta del panel /admin puede leerlos
// y borrarlos; nadie puede editarlos.
service cloud.firestore {
  match /databases/{database}/documents {

    function texto(v, max) { return v is string && v.size() > 0 && v.size() <= max; }
    function textoOpcional(v, max) { return v == null || (v is string && v.size() <= max); }
    // Panel /admin: solo la cuenta del equipo puede leer y borrar registros.
    function esAdmin() {
      return request.auth != null && request.auth.token.email == 'admin@hatun-joven.web.app';
    }

    // RF-04: inscripción de participantes. Se acepta cualquier edad; el equipo filtra en /admin (rango objetivo: 14 a 20).
    match /inscripciones/{id} {
      allow create: if request.resource.data.keys().hasOnly([
            'nombres', 'apellidoPaterno', 'apellidoMaterno', 'edad', 'colegio', 'celular', 'consentimiento',
            'compartirAliados', 'autorizacionAdulto', 'creado'])
        && texto(request.resource.data.nombres, 80)
        && texto(request.resource.data.apellidoPaterno, 60)
        && texto(request.resource.data.apellidoMaterno, 60)
        && request.resource.data.edad is int
        && request.resource.data.edad >= 1 && request.resource.data.edad <= 120
        && texto(request.resource.data.colegio, 120)
        && texto(request.resource.data.celular, 20)
        && request.resource.data.consentimiento == true
        // Autorización opcional para compartir con aliados (ver /privacidad).
        && request.resource.data.get('compartirAliados', false) is bool
        // Menores de 14: un adulto responsable sabe que asiste (lo marca el formulario).
        && request.resource.data.get('autorizacionAdulto', false) is bool
        && request.resource.data.creado == request.time;
      allow read, delete: if esAdmin();
      allow update: if false;
    }

    // RF-06: postulación de aliados (sponsors o comunidades).
    match /aliados/{id} {
      allow create: if request.resource.data.keys().hasOnly([
            'organizacion', 'contacto', 'cargo', 'correo', 'celular', 'tipo', 'mensaje',
            'consentimiento', 'creado'])
        && texto(request.resource.data.organizacion, 120)
        && texto(request.resource.data.contacto, 120)
        && textoOpcional(request.resource.data.get('cargo', null), 80)
        && texto(request.resource.data.correo, 120)
        && texto(request.resource.data.celular, 20)
        && request.resource.data.tipo in ['sponsor', 'comunidad']
        && textoOpcional(request.resource.data.get('mensaje', null), 2000)
        && request.resource.data.consentimiento == true
        && request.resource.data.creado == request.time;
      allow read, delete: if esAdmin();
      allow update: if false;
    }

    // Event Hub · Ponentes y dinámicas (data room). Solo la cuenta del panel lee y escribe.
    function opcional(k, max) { return textoOpcional(request.resource.data.get(k, null), max); }
    match /ponentes/{id} {
      allow read, delete: if esAdmin();
      allow create, update: if esAdmin()
        && request.resource.data.keys().hasOnly([
            'eventoId', 'nombres', 'apellidos', 'cargo', 'organizacion', 'foto', 'linkedin', 'bio',
            'participa', 'tema', 'publicar', 'correo', 'telefono', 'notas', 'actualizado'])
        && request.resource.data.eventoId == 'hj-2027'
        && texto(request.resource.data.nombres, 80)
        && texto(request.resource.data.apellidos, 80)
        && request.resource.data.participa in ['Charla', 'Dinámica', 'Charla y dinámica', 'Panel']
        && request.resource.data.publicar is bool
        && opcional('cargo', 120) && opcional('organizacion', 120) && opcional('foto', 500)
        && opcional('linkedin', 300) && opcional('bio', 2000) && opcional('tema', 200)
        && opcional('correo', 120) && opcional('telefono', 20) && opcional('notas', 2000)
        && request.resource.data.actualizado == request.time;
    }

    // Todo lo demás, cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
