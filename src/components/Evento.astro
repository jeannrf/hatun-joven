---
// SRS 5 (#evento): fecha, horario y zonas.
import { evento, encuentro } from '../content/home';
---
<section class="evt" id="evento" aria-labelledby="evt-t">
  <div class="wrap evt__in">
    <div class="evt__info">
      <h2 class="evt__t d" id="evt-t">{encuentro.titulo}</h2>
      <p class="evt__bajada">{encuentro.bajada}</p>

      <dl class="evt__datos">
        <div><dt>Fecha</dt><dd>{evento.fechaLarga}</dd></div>
        <div><dt>Horario</dt><dd>{encuentro.horario}</dd></div>
      </dl>
    </div>

    <ul class="evt__zonas">
      {encuentro.zonas.map((z) => (
        <li class="zona">
          <p class="zona__num"><span class="d">{z.numero}</span> {z.unidad}</p>
          <p class="zona__nombre d">{z.nombre}</p>
          <p class="zona__det">{z.detalle}</p>
        </li>
      ))}
    </ul>
  </div>
</section>


<style>
  .evt { padding-block: clamp(5rem, 10vw, 9rem) clamp(2rem, 4vw, 3rem); }
  .evt__in { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(2rem, 4vw, 4rem); align-items: stretch; }
  .evt__info { display: grid; gap: clamp(1.25rem, 2vw, 1.75rem); align-content: center; }
  .evt__t { font-size: clamp(2.75rem, 6vw, 5.5rem); }
  .evt__bajada { font-size: clamp(1.2rem, 1.7vw, 1.5rem); line-height: 1.4; max-width: 34ch; }
  .evt__datos { max-width: 34rem; display: grid; gap: 0.8rem; padding-block: 1.1rem; border-block: 3px dashed rgb(42 27 180 / 0.3); }
  .evt__datos div { display: grid; grid-template-columns: 6rem 1fr; gap: 1rem; align-items: baseline; }
  .evt__datos dt { font-weight: 700; font-size: 0.85rem; letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.8; }
  .evt__datos dd { margin: 0; font-weight: 700; font-size: clamp(1.1rem, 1.4vw, 1.3rem); }

  .evt__zonas { list-style: none; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); align-content: center; gap: clamp(1rem, 2vw, 1.5rem); }
  .zona { display: grid; gap: 0.4rem; padding: clamp(1.25rem, 2.5vw, 2rem); border-radius: 1rem; background: var(--indigo); color: var(--marfil); }
  .zona__num { font-weight: 700; font-size: 1.1rem; }
  .zona__num .d { font-size: clamp(3rem, 5.5vw, 5rem); color: var(--verde); line-height: 0.9; margin-right: 0.15em; }
  .zona__nombre { font-size: clamp(1.4rem, 2.2vw, 2rem); }
  .zona__det { font-size: 1.05rem; line-height: 1.45; }

  @media (max-width: 860px) {
    .evt__in { grid-template-columns: 1fr; }
    .evt__zonas { grid-template-columns: 1fr; }
    .evt__in { text-align: center; }
    .evt__bajada, .evt__datos { margin-inline: auto; width: 100%; }
    .evt__datos div { grid-template-columns: 1fr; gap: 0.15rem; }
  }
</style>
