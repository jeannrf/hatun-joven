---
// Formulario de aliado (RF-06). El tipo (sponsor o comunidad) viene fijo por el modal que lo abre.
import { modales } from '../content/home';
interface Props { tipo: 'sponsor' | 'comunidad' }
const { tipo } = Astro.props;
const p = tipo === 'sponsor' ? 's' : 'c';
const orgLabel = tipo === 'sponsor' ? 'Organización' : 'Nombre de la comunidad';
---
<form class="form" data-form="aliados" data-tipo={tipo} novalidate>
  <div class="campo campo--full">
    <label for={`${p}-org`}>{orgLabel}</label>
    <input id={`${p}-org`} name="organizacion" autocomplete="organization" required maxlength="120" />
    <p class="campo__error" id={`${p}-org-e`} aria-live="polite"></p>
  </div>
  <div class="campo">
    <label for={`${p}-contacto`}>Nombre de contacto</label>
    <input id={`${p}-contacto`} name="contacto" autocomplete="name" required maxlength="120" />
    <p class="campo__error" id={`${p}-contacto-e`} aria-live="polite"></p>
  </div>
  <div class="campo">
    <label for={`${p}-cargo`}>Cargo <span class="opc">(opcional)</span></label>
    <input id={`${p}-cargo`} name="cargo" autocomplete="organization-title" maxlength="80" />
    <p class="campo__error" id={`${p}-cargo-e`} aria-live="polite"></p>
  </div>
  <div class="campo">
    <label for={`${p}-correo`}>Correo</label>
    <input id={`${p}-correo`} name="correo" type="email" autocomplete="email" required maxlength="120" />
    <p class="campo__error" id={`${p}-correo-e`} aria-live="polite"></p>
  </div>
  <div class="campo">
    <label for={`${p}-celular`}>Celular</label>
    <input id={`${p}-celular`} name="celular" type="tel" inputmode="tel" autocomplete="tel" placeholder="9XX XXX XXX" required />
    <p class="campo__error" id={`${p}-celular-e`} aria-live="polite"></p>
  </div>
  <div class="campo campo--full">
    <label for={`${p}-mensaje`}>Cuéntanos cómo te gustaría sumar <span class="opc">(opcional)</span></label>
    <textarea id={`${p}-mensaje`} name="mensaje" rows="3" maxlength="2000"></textarea>
    <p class="campo__error" id={`${p}-mensaje-e`} aria-live="polite"></p>
  </div>
  <div class="check campo--full">
    <input id={`${p}-consentimiento`} name="consentimiento" type="checkbox" required />
    <label for={`${p}-consentimiento`}>{modales.consentimiento} <a href="/privacidad" target="_blank" rel="noopener">Política de privacidad</a>.</label>
    <p class="campo__error" id={`${p}-consentimiento-e`} aria-live="polite"></p>
  </div>
  <div class="trampa" aria-hidden="true"><label>No llenar <input name="web" tabindex="-1" autocomplete="off" /></label></div>
  <div class="form__pie campo--full">
    <button class="btn btn--p" type="submit">Enviar postulación</button>
    <p class="form__estado" role="status" aria-live="polite"></p>
  </div>
</form>
