---
// SRS 4 + 9 (#aliados): el alcance que buscamos y los dos caminos para sumarse.
import { aliados } from '../content/home';
import { cells } from './motifs';
const marcas = { sponsor: cells('rombo'), comunidad: cells('llama') } as const;
---
<section class="ali" id="aliados" aria-labelledby="ali-t">
  <div class="wrap ali__in">
    <header class="ali__hd">
      <h2 class="ali__t d" id="ali-t">{aliados.titulo}</h2>
      <p class="ali__bajada">{aliados.bajada}</p>
    </header>

    <ul class="metas">
      {aliados.metas.map((m) => (
        <li><span class="metas__v d">{m.valor}</span><span class="metas__t">{m.texto}</span></li>
      ))}
    </ul>

    <div class="caminos">
      {aliados.caminos.map((c) => (
        <article class="camino">
          <svg viewBox="0 0 10 10" width="44" height="44" aria-hidden="true" shape-rendering="crispEdges">
            {marcas[c.modal as keyof typeof marcas].map(([x, y]) => <rect x={x} y={y} width="1" height="1" />)}
          </svg>
          <h3 class="camino__t d">{c.titulo}</h3>
          <p class="camino__txt">{c.texto}</p>
          <a class="btn btn--p" href="#aliados" data-modal={c.modal}>{c.cta}</a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .ali { padding-block: clamp(5rem, 10vw, 9rem); }
  .ali__in { display: grid; gap: clamp(2.5rem, 5vw, 4rem); }
  .ali__hd { display: grid; gap: 1.25rem; max-width: 52rem; }
  .ali__t { font-size: clamp(2.75rem, 6vw, 5.5rem); }
  .ali__bajada { font-size: clamp(1.2rem, 1.8vw, 1.6rem); line-height: 1.4; max-width: 40ch; }

  .metas { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 4px solid var(--indigo); }
  .metas li { display: grid; gap: 0.5rem; align-content: start; padding: 1.5rem clamp(1rem, 2.5vw, 2.25rem) 0; position: relative; }
  .metas li:first-child { padding-left: 0; }
  .metas li + li::before { content: ''; position: absolute; left: 0; top: 1.5rem; bottom: 0; width: 6px;
    background: linear-gradient(180deg, transparent 3px, var(--magenta) 3px 9px, transparent 9px) 0 0 / 100% 12px no-repeat space; }
  .metas__v { font-size: clamp(3.5rem, 7vw, 6.5rem); line-height: 0.85; color: var(--magenta); }
  .metas__t { font-weight: 700; font-size: clamp(1.05rem, 1.4vw, 1.25rem); line-height: 1.35; max-width: 22ch; }

  .caminos { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(1rem, 2vw, 1.5rem); }
  .camino { display: grid; gap: 0.9rem; justify-items: start; align-content: start; padding: clamp(1.5rem, 3vw, 2.5rem); border: 3px solid var(--indigo); border-radius: 1rem; background: #fffdf8; transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease); }
  .camino:hover { transform: translateY(-4px); box-shadow: 0 18px 32px -22px rgb(29 17 134 / 0.5); }
  .camino svg { fill: var(--indigo); }
  .camino:nth-child(2) svg { fill: var(--magenta); }
  .camino__t { font-size: clamp(1.75rem, 3vw, 2.75rem); }
  .camino__txt { font-size: 1.1rem; line-height: 1.45; max-width: 38ch; }
  .ali__in > *, .caminos > * { min-width: 0; }
  .camino .btn { white-space: normal; text-align: center; }

  @media (max-width: 760px) {
    .metas { grid-template-columns: 1fr; text-align: center; }
    .metas li, .metas li:first-child { padding: 1.5rem 0 0; justify-items: center; }
    .metas li + li { margin-top: 1.25rem; }
    .metas li + li::before { left: 0; right: 0; top: 0; bottom: auto; width: auto; height: 6px;
      background: linear-gradient(90deg, transparent 3px, var(--magenta) 3px 9px, transparent 9px) 0 0 / 12px 100% space no-repeat; }
    .caminos { grid-template-columns: 1fr; }
  }
</style>
