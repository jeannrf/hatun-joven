---
// Contenido web (CMS): reservado. Lo construye otro integrante del equipo; aquí solo queda anunciado.
import Hub from '../../layouts/Hub.astro';
---
<Hub titulo="Contenido" activo="contenido" migas={['Web', 'Contenido']}>
  <header class="hb-cab">
    <div>
      <h1 class="d">Contenido web</h1>
      <p>Aquí se editarán los textos, el cronograma y las imágenes de la página pública.</p>
    </div>
    <p class="hb-estado-mod">Próximamente</p>
  </header>

  <section class="hb-pronto-bloque">
    <h2>Esta sección está en camino</h2>
    <p>La construye otro miembro del equipo. Cuando esté lista, el programa, los ponentes y los sponsors que registren en el Hub podrán publicarse en la web desde aquí.</p>
  </section>
</Hub>
