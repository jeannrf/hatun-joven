---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Nosotros from '../components/Nosotros.astro';
import Impacto from '../components/Impacto.astro';
import Cronograma from '../components/Cronograma.astro';
import Cierre from '../components/Cierre.astro';
import Modales from '../components/Modales.astro';
import KnitBand from '../components/KnitBand.astro';
import Evento from '../components/Evento.astro';
import Aliados from '../components/Aliados.astro';
import Preguntas from '../components/Preguntas.astro';
---
<Base
  title="Hatun Joven · 6 de marzo de 2027 · Jauja"
  description="Un movimiento de liderazgo e impacto social juvenil en la Primera Capital Histórica del Perú. Inscríbete al encuentro del 6 de marzo de 2027 en Jauja."
>
  <Header />
  <main>
    <Hero />
    <Nosotros />
    <KnitBand motifs={['flor', 'rombo', 'llama', 'rombo']} accents={['var(--verde)', 'var(--marfil)', 'var(--amarillo)', 'var(--marfil)']} />
    <Evento />
    <Cronograma />
    <Impacto />
    <KnitBand dir="right" motifs={['greca', 'rombo']} fg="var(--indigo)" bg="var(--marfil)" accents={['var(--indigo)', 'var(--magenta)']} />
    <Aliados />
    <KnitBand motifs={['rombo', 'llama', 'flor', 'venado']} accents={['var(--marfil)', 'var(--amarillo)', 'var(--verde)', 'var(--marfil)']} />
    <Preguntas />
  </main>
  <Cierre />
  <Modales />
</Base>
