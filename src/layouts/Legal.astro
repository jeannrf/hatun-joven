---
// Páginas legales (privacidad, condiciones): mismo encabezado simple, columna de lectura y botón de vuelta.
import Base from './Base.astro';

interface Props { title: string; description: string; titulo: string; actualizada: string }
const { title, description, titulo, actualizada } = Astro.props;
---
<Base title={title} description={description} ld={false}>
  <header class="lg-hd">
    <div class="wrap lg-hd__in">
      <a href="/" class="lg-hd__logo" aria-label="Hatun Joven, volver al inicio">
        <img src="/img/hatun-joven-wordmark-sm.webp" width="278" height="139" alt="" />
      </a>
      <a href="/" class="lg-hd__volver">← Volver al inicio</a>
    </div>
  </header>

  <main class="wrap lg">
    <h1 class="lg__t d">{titulo}</h1>
    <p class="lg__fecha">Última actualización: {actualizada}</p>
    <slot />
    <p class="lg__volver"><a href="/" class="btn btn--p">Volver al inicio</a></p>
  </main>
</Base>

<style>
  .lg-hd { border-bottom: 2px dashed rgb(42 27 180 / 0.3); }
  .lg-hd__in { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 4.75rem; }
  .lg-hd__logo img { display: block; height: 3.25rem; width: auto; }
  .lg-hd__volver { font-weight: 700; }

  .lg { max-width: 46rem; padding-block: clamp(3rem, 7vw, 5rem) clamp(4rem, 8vw, 6rem); display: grid; gap: 2.25rem; }
  .lg__t { font-size: clamp(2.5rem, 7vw, 4.5rem); }
  .lg__fecha { margin-top: -1.5rem; font-size: 0.95rem; opacity: 0.8; }
  .lg :global(.lg__intro) { font-size: clamp(1.2rem, 1.8vw, 1.4rem); line-height: 1.5; }
  .lg :global(section) { display: grid; gap: 0.85rem; }
  .lg :global(h2) { font-size: clamp(1.4rem, 3vw, 1.9rem); }
  .lg :global(p), .lg :global(li) { font-size: 1.1rem; line-height: 1.6; }
  .lg :global(ul) { padding-left: 1.25rem; display: grid; gap: 0.5rem; }
  .lg :global(a:not(.btn)) { font-weight: 700; text-decoration-color: var(--magenta); text-underline-offset: 0.2em; }
  .lg__volver { margin-top: 1rem; }
</style>
