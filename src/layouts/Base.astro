---
import '../styles/global.css';
import { evento } from '../content/home';

interface Props { title: string; description: string }
const { title, description } = Astro.props;

const sitio = Astro.site ?? new URL('https://hatun-joven.web.app');
const canonical = new URL(Astro.url.pathname, sitio).href;
const og = new URL('/og.png', sitio).href;

// RNF-07: datos estructurados schema.org/Event (sin precio: el costo aún no está confirmado).
const eventoLD = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: 'Hatun Joven 2027',
  description,
  startDate: evento.fechaISO,
  endDate: '2027-03-06T17:00:00-05:00',
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: {
    '@type': 'Place',
    name: `${evento.lugar}, ${evento.ciudad}`,
    address: { '@type': 'PostalAddress', addressLocality: 'Jauja', addressRegion: 'Junín', addressCountry: 'PE' },
  },
  image: [og],
  organizer: { '@type': 'Organization', name: 'Hatun Joven', url: sitio.href },
  url: sitio.href,
};
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#2A1BB4" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- RF-15: vista previa al compartir en WhatsApp, Facebook, Instagram, LinkedIn y X -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:site_name" content="Hatun Joven" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Hatun Joven · 6 de marzo de 2027 · Auditorio IEP Pitágoras, Jauja" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />

    <link rel="preload" href="/img/hatun-joven-wordmark.webp" as="image" type="image/webp" fetchpriority="high" />
    <script type="application/ld+json" set:html={JSON.stringify(eventoLD)} />
  </head>
  <body>
    <slot />
  </body>
</html>
